# Copy into .env when running: docker compose up -d
#
# Host ports: Postgres 54322 | Kong 54323 | Studio 54324 | Redis 16379
#             RabbitMQ 25672 (mgmt 25673) | ES 19200 | Unstructured 18001

# --- Postgres ---
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@supabase-db:5432/postgres
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@supabase-db:54322/postgres
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@supabase-db:54322/postgres

# --- Supabase Storage (demo service_role key) ---
SUPABASE_URL=http://supabase-db:54323
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Redis ---
REDIS_URL=redis://redis:16379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:25672/

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:19200

# --- Unstructured API ---
UNSTRUCTURED_API_URL=http://unstructured:18001
UNSTRUCTURED_API_KEY=

# --- App Auth (fill in) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
GOOGLE_API_KEY=
