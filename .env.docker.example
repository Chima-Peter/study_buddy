# Copy values into your local `.env` when running infra via:
#   docker compose up -d
#
# Local Supabase provides Postgres (app + checkpoints) and Storage.

# --- App ---
APP_NAME=StudyBuddy
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Supabase Postgres (docker service: supabase-db) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Supabase API / Storage (Kong → http://localhost:54321) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=e...

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_BASE_MS=5000
RABBITMQ_RETRY_MAX_MS=300000

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Unstructured API (docker compose service `unstructured`) ---
UNSTRUCTURED_API_URL=http://localhost:8001
# LEAVE EMPTY FOR LOCAL HOSTED API, USE API KEY FOR REMOTE API
UNSTRUCTURED_API_KEY=

# --- Auth / LLM (fill in locally) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
GOOGLE_API_KEY=
